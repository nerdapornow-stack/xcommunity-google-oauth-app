<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets us check that the Xcommunity app is installed and signed with
         the same key as this app before handing it a token. -->
    <queries>
        <package android:name="com.xcommunity.app" />
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false">

        <!-- Launched from the home screen it shows the token to copy; started
             for result by the Xcommunity app (same signing key) it returns
             the token to that app instead. -->
        <activity
            android:name=".OAuthActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale|locale|layoutDirection"
            android:exported="true"
            android:theme="@style/Theme.XcommunityOAuth">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.xcommunity.app.google_oauth.action.REQUEST_TOKEN" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
